---
/**
 * Layout.astro
 * Plantilla raíz. Gestiona todo el <head>: metadatos, SEO, OG, rendimiento.
 *
 * Props esperadas desde cada página:
 *  - title        : Título de la pestaña y OG (obligatorio)
 *  - description  : Meta description y OG description (obligatorio)
 *  - canonicalURL : URL canónica de la página (obligatorio)
 *  - ogImage      : Ruta de la imagen Open Graph (opcional, tiene fallback)
 */

import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalURL,
  ogImage = '/images/og-default.webp', // imagen OG por defecto
} = Astro.props;

const siteName = 'Alexandria Studio';
---

<!doctype html>
<html lang="es">
  <head>
    <!-- ─── Charset y Viewport ────────────────────────────────────────────── -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />

    <!-- ─── Favicon ──────────────────────────────────────────────────────── -->
    <!-- SVG: navegadores modernos (Chrome 80+, Firefox, Edge) -->
    <link rel="icon" type="image/svg+xml" href="/Alexandria.svg" />
    <!-- PNG: fallback para Safari y navegadores que no soportan SVG -->
    <link rel="icon" type="image/png" href="/Alexandria.png" />
    <!-- ICO: fallback universal para navegadores antiguos -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Apple Touch Icon (pantalla de inicio en iOS/macOS) -->
    <link rel="apple-touch-icon" href="/Alexandria.png" />
    <!-- Web App Manifest (PWA básica, controla apariencia en móviles) -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- ─── Metadatos primarios SEO ──────────────────────────────────────── -->
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:160, max-image-preview:large" />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#005BB5" />

    <!-- ─── Canonical URL (evita contenido duplicado) ────────────────────── -->
    <!--
      IMPORTANTE: La URL canónica debe ser la versión definitiva de la página
      (con o sin www, siempre HTTPS). Pásala como prop desde cada page.
    -->
    <link rel="canonical" href={canonicalURL} />

    <!-- ─── Open Graph (Facebook, LinkedIn, WhatsApp, etc.) ──────────────── -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:site_name"   content={siteName} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"      content="es_MX" />

    <!-- ─── Twitter Card ─────────────────────────────────────────────────── -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <!-- <meta name="twitter:site" content="@AlexandriaStudio" /> -->

    <!-- ─── Rendimiento: Preconnect & DNS-Prefetch para CDNs externos ─────── -->
    <!--
      preconnect  → abre la conexión TCP/TLS completa con anticipación.
                    Usar para recursos que se cargarán de forma segura (fuentes, analytics).
      dns-prefetch → solo resuelve DNS. Más barato; para dominios de baja prioridad.

      REGLA: preconnect para los 2-3 CDNs más críticos; dns-prefetch para el resto.
    -->

    <!-- Google Fonts (Inter y Geist Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" />

    <!-- Bunny Fonts (alternativa a Google Fonts sin envío de datos a EU) -->
    <!-- <link rel="preconnect" href="https://fonts.bunny.net" /> -->

    <!-- CDN de imágenes / media (ej. Cloudinary, Cloudflare Images) -->
    <!-- <link rel="preconnect" href="https://res.cloudinary.com" /> -->
    <!-- <link rel="dns-prefetch" href="https://res.cloudinary.com" /> -->

    <!-- Analytics (solo dns-prefetch; no bloquear el render) -->
    <!-- <link rel="dns-prefetch" href="https://www.googletagmanager.com" /> -->
    <!-- <link rel="dns-prefetch" href="https://plausible.io" /> -->

    <!-- ─── Structured Data (JSON-LD) ─────────────────────────────────────── -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": ["LocalBusiness", "ProfessionalService"],
        "name": "Alexandria Studio",
        "url": "https://alexandriastudio.cloud",
        "logo": "https://alexandriastudio.cloud/Alexandria.svg",
        "image": "https://alexandriastudio.cloud/Alexandria.png",
        "description": "Consultoría tecnológica en Ciudad de México: Mesa de Ayuda, Infraestructura de Redes, Ciberseguridad, Desarrollo Web, Automatización e Inteligencia Artificial.",
        "foundingDate": "2017",
        "areaServed": {
          "@type": "City",
          "name": "Ciudad de México"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Ciudad de México",
          "addressCountry": "MX"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": "+52-55-1850-5071",
            "contactType": "customer support",
            "availableLanguage": "Spanish",
            "email": "andres.rivera@alexandriastudio.cloud"
          }
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios de TI",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mesa de Ayuda" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mantenimiento Preventivo" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Infraestructura de Redes" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ciberseguridad y Protección" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sistemas Administrativos y POS" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desarrollo Web y Plataformas" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Software y Arquitectura a la Medida" } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automatización e Inteligencia Artificial" } }
          ]
        },
        "sameAs": [
          "https://www.linkedin.com/company/alexandria-studio",
          "https://github.com/alexandria-studio"
        ]
      }
    </script>

    <!-- ─── Slot para metadatos adicionales por página ────────────────────── -->
    <slot name="head" />
  </head>

  <body>
    <!-- Contenido principal inyectado por cada página -->
    <slot />

    <!-- Botón volver al inicio — visible solo fuera del Hero -->
    <button
      id="back-to-top"
      aria-label="Volver al inicio de la página"
      title="Volver al inicio"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </button>

    <style is:global>
      #back-to-top {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 900;
        width: 2.75rem;
        height: 2.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-graphite-700, #111214);
        border: 1px solid var(--color-graphite-500, #363739);
        border-radius: 50%;
        color: var(--color-slate-200, #9c9c9d);
        cursor: pointer;
        padding: 0;
        opacity: 0;
        transform: translateY(0.75rem);
        pointer-events: none;
        transition: opacity 0.3s ease, transform 0.3s ease, border-color 0.2s, color 0.2s, box-shadow 0.2s;
      }

      #back-to-top.is-visible {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      #back-to-top:hover {
        color: var(--color-azure-glow, #0088ff);
        border-color: var(--color-azure-core, #005bb5);
        box-shadow: 0 0 14px rgba(0, 136, 255, 0.25);
      }

      #back-to-top:active {
        transform: translateY(2px);
      }

      @media (max-width: 480px) {
        #back-to-top {
          bottom: 1.25rem;
          right: 1.25rem;
          width: 2.5rem;
          height: 2.5rem;
        }
      }
    </style>

    <script is:inline>
      (function () {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        /* Observa el Hero (#inicio); si sale del viewport muestra el botón */
        const hero = document.getElementById('inicio');
        if (hero) {
          const obs = new IntersectionObserver(
            ([entry]) => btn.classList.toggle('is-visible', !entry.isIntersecting),
            { threshold: 0 }
          );
          obs.observe(hero);
        } else {
          /* Fallback para páginas sin Hero: scroll > 300px */
          window.addEventListener('scroll', () => {
            btn.classList.toggle('is-visible', window.scrollY > 300);
          }, { passive: true });
        }
      })();
    </script>

    <style is:global>
      :root {
        /* Fuents desde DESIGN.md */
        --font-inter: 'Inter Variable', 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
        --font-geistmono: 'Geist Mono', 'GeistMono', ui-monospace, SFMono-Regular, monospace;

        /* Colores Base */
        --color-void-black: #040506;
        --color-deep-charcoal: #07080a;
        --color-snow: #ffffff;
        --color-slate-200: #9c9c9d;
      }

      html {
        font-family: var(--font-inter);
        background-color: var(--color-void-black);
        color: var(--color-snow);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        margin: 0;
        padding: 0;
      }

      /* Estilos para código/mono */
      code, pre, .mono {
        font-family: var(--font-geistmono);
      }
    </style>
  </body>
</html>
