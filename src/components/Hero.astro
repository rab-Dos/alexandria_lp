---
/**
 * components/Hero.astro
 * Sección hero — contiene el ÚNICO <h1> de la página.
 *
 * Criterios SEO del H1:
 *  - Incluye la keyword primaria del negocio.
 *  - Es descriptivo, no genérico ("Bienvenido" no sirve).
 *  - Idealmente ≤ 60 caracteres para no cortarse en SERPs.
 */
---

<section
  id="inicio"
  aria-labelledby="hero-heading"
  class="hero-section"
>
  <div class="container">

    <div class="hero-content">

      <!-- Eyebrow: etiqueta pequeña sobre el H1, no es heading semántico -->
      <p class="hero-eyebrow" aria-hidden="true">
        Consultoría en Sistemas, Redes y Continuidad Digital · Ciudad de México
      </p>

      <!--
        H1 — Keyword primaria + propuesta de valor.
        Una sola instancia en toda la página.
      -->
      <h1 id="hero-heading">
        Tu punto de referencia&nbsp;en&nbsp;sistemas
      </h1>

      <!-- Párrafo de apoyo que amplía el H1 sin duplicar keywords -->
      <p class="hero-description">
        Somos tu departamento de TI externo. Desde 2017 hemos evolucionado
        junto con la tecnología, cubriendo <strong>Infraestructura</strong>,
        <strong>Seguridad</strong> y <strong>Nube</strong> para que tú te enfoques
        en tu negocio mientras nosotros aseguramos tu operación.
      </p>

      <!-- CTA primario — acción de mayor importancia en la página -->
      <div class="hero-actions">
        <a href="#contacto" class="btn btn-primary">
          Agenda una consulta gratuita
        </a>
        <a href="#servicios" class="btn btn-secondary">
          Conoce nuestros servicios
        </a>
      </div>

    </div>

    <!-- Imagen o ilustración del hero -->
    <div class="hero-visual" aria-hidden="true">
      <img
        src="/images/hero-lighthouse.webp"
        alt=""
        width="600"
        height="500"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <!--
        alt="" vacío porque es decorativa; el texto del H1 ya describe la intención.
        Si la imagen añade contexto único, escribir alt descriptivo.
      -->
    </div>

  </div>
</section>
