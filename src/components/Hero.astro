---
/**
 * components/Hero.astro
 * Sección hero — contiene el ÚNICO <h1> de la página.
 *
 * Criterios SEO del H1:
 *  - Incluye la keyword primaria del negocio.
 *  - Es descriptivo, no genérico ("Bienvenido" no sirve).
 *  - Idealmente ≤ 60 caracteres para no cortarse en SERPs.
 */
---

<section
  id="inicio"
  aria-labelledby="hero-heading"
  class="hero-section"
>
  <!-- Canvas de animación: fondo absoluto bajo todo el contenido -->
  <canvas id="hero-canvas" aria-hidden="true"></canvas>

  <div class="container">

    <div class="hero-content">

      <!-- Eyebrow: etiqueta pequeña sobre el H1, no es heading semántico -->
      <p class="hero-eyebrow" aria-hidden="true">
        Consultoría en Sistemas, Redes y Continuidad Digital · Ciudad de México
      </p>

      <!--
        H1 — Keyword primaria + propuesta de valor.
        Una sola instancia en toda la página.
      -->
      <h1 id="hero-heading">
        Tu punto de referencia&nbsp;en&nbsp;sistemas
      </h1>

      <!-- Párrafo de apoyo que amplía el H1 sin duplicar keywords -->
      <p class="hero-description">
        Somos tu departamento de TI externo. Desde 2017 hemos evolucionado
        junto con la tecnología, cubriendo <strong>Infraestructura</strong>,
        <strong>Seguridad</strong> y <strong>Nube</strong> para que tú te enfoques
        en tu negocio mientras nosotros aseguramos tu operación.
      </p>

      <!-- CTA primario — acción de mayor importancia en la página -->
      <div class="hero-actions">
        <a href="#contacto" class="btn btn-primary">
          Agenda una consulta gratuita
        </a>
        <a href="#servicios" class="btn btn-secondary">
          Conoce nuestros servicios
        </a>
      </div>

    </div>

    <!-- Imagen o ilustración del hero -->
    <div class="hero-visual" aria-hidden="true">
      <img
        src="/images/hero-lighthouse.webp"
        alt=""
        width="600"
        height="500"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <!--
        alt="" vacío porque es decorativa; el texto del H1 ya describe la intención.
        Si la imagen añade contexto único, escribir alt descriptivo.
      -->
    </div>

  </div>
</section>

<script>
  // ── Animación de fondo del Hero: malla de olas fluidas (estilo Raycast) ──
  const canvas  = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const ctx     = canvas.getContext('2d')!;
  const section = canvas.closest('.hero-section') as HTMLElement;

  let width: number, height: number;
  let time = 0;
  let waveGradient: CanvasGradient;

  const NUM_LINES        = 25;
  const SCANNER_INTERVAL = 20_000; // ms entre barridos de luz
  const SCANNER_DURATION =  5_000; // ms que dura cada barrido

  interface EnergyPulse {
    lineIndex: number;
    x: number;
    speed: number;
    length: number;
    opacity: number;
  }
  let energyPulses: EnergyPulse[] = [];

  function resizeCanvas(): void {
    const rect = section.getBoundingClientRect();
    width  = canvas.width  = rect.width  || window.innerWidth;
    height = canvas.height = rect.height || window.innerHeight;

    // Degradado horizontal usando la paleta Azure de la marca
    waveGradient = ctx.createLinearGradient(0, 0, width, 0);
    waveGradient.addColorStop(0,   'rgba(0,  51, 102, 0)');
    waveGradient.addColorStop(0.2, 'rgba(0,  91, 181, 0.5)');
    waveGradient.addColorStop(0.5, 'rgba(0, 136, 255, 0.8)');
    waveGradient.addColorStop(0.8, 'rgba(0,  51, 102, 0.5)');
    waveGradient.addColorStop(1,   'rgba(0,  51, 102, 0)');
  }

  // Observa cambios de tamaño de la sección (responsive)
  const ro = new ResizeObserver(resizeCanvas);
  ro.observe(section);
  resizeCanvas();

  function trySpawnPulse(): void {
    if (Math.random() < 0.02 && energyPulses.length < 4) {
      energyPulses.push({
        lineIndex: Math.floor(Math.random() * NUM_LINES),
        x:         -100,
        speed:     15 + Math.random() * 15,
        length:    150 + Math.random() * 200,
        opacity:   1,
      });
    }
  }

  function getY(x: number, i: number, norm: number): number {
    const yBase = height * 0.5 + i * 18;
    return yBase
      + Math.sin(x * 0.002 + time * 0.008 + i * 0.08) * (40 + norm * 45)
      + Math.cos(x * 0.004 - time * 0.012 + i * 0.05) * 25;
  }

  function animate(): void {
    // Fondo Void Black (#040506)
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = '#040506';
    ctx.fillRect(0, 0, width, height);

    const timeInCycle = Date.now() % SCANNER_INTERVAL;

    // 1. Barrido de luz (faro) — Azure Frost, modo screen
    if (timeInCycle < SCANNER_DURATION) {
      const progress = timeInCycle / SCANNER_DURATION;
      const opacity  = Math.sin(progress * Math.PI) * 0.15;
      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      ctx.fillStyle  = `rgba(209, 232, 255, ${opacity})`;
      ctx.shadowBlur = 150;
      ctx.shadowColor = 'rgba(0, 136, 255, 0.4)';
      ctx.beginPath();
      const currentX = width * 1.5 - width * 2 * progress;
      ctx.moveTo(width, 0);
      ctx.lineTo(currentX + width * 0.8, height);
      ctx.lineTo(currentX - width * 0.8, height);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    // 2. Malla de olas (blending screen para que los cruces sean más brillantes)
    ctx.globalCompositeOperation = 'screen';
    for (let i = 0; i < NUM_LINES; i++) {
      const norm = i / NUM_LINES;
      ctx.beginPath();
      ctx.lineWidth   = 0.5 + norm * 2;
      ctx.strokeStyle = waveGradient;
      for (let x = 0; x <= width; x += 20) {
        const y = getY(x, i, norm);
        x === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    // 3. Pulsos de energía (Snow + resplandor Azure Glow)
    trySpawnPulse();
    for (let i = energyPulses.length - 1; i >= 0; i--) {
      const pulse = energyPulses[i];
      const norm  = pulse.lineIndex / NUM_LINES;
      ctx.beginPath();
      ctx.strokeStyle = `rgba(255, 255, 255, ${pulse.opacity})`;
      ctx.lineWidth   = 1 + norm * 2.5;
      ctx.shadowBlur  = 15;
      ctx.shadowColor = '#0088FF';
      let started = false;
      const x0 = Math.max(0, pulse.x - pulse.length);
      const x1 = Math.min(width, pulse.x);
      for (let x = x0; x <= x1; x += 10) {
        const y = getY(x, pulse.lineIndex, norm);
        if (!started) { ctx.moveTo(x, y); started = true; }
        else            ctx.lineTo(x, y);
      }
      if (started) ctx.stroke();
      ctx.shadowBlur = 0;
      pulse.x += pulse.speed;
      if (pulse.x - pulse.length > width) energyPulses.splice(i, 1);
    }

    time++;
    requestAnimationFrame(animate);
  }

  animate();
</script>
