---
/**
 * components/Pricing.astro
 * Sección "Paquetes" — dos bloques:
 *   1. Estabilidad Operativa: Planes de Soporte TI (Essential / Business Pro / Premium)
 *   2. Ingeniería y Evolución: Paquetes Web (One Page / Corporativa / E-Commerce)
 * Incluye tabla comparativa premium y beneficios por pago anticipado.
 */
---

<section
  id="paquetes"
  aria-labelledby="pricing-heading"
  class="pricing-section"
>

  <!-- ── Atmosphère radial (misma convención que Services) ─────── -->
  <div class="pricing-atmosphere" aria-hidden="true"></div>

  <div class="container">

    <!-- ── Encabezado ──────────────────────────────────────────── -->
    <header class="pricing-header">
      <h2 id="pricing-heading">
        Diseñados a la medida&nbsp;de&nbsp;tu&nbsp;crecimiento
      </h2>
      <p class="section-subtitle">
        En Alexandria Studio no creemos en cobrar por sorpresas. Nuestros planes
        están estructurados para brindarte exactamente el nivel de soporte y
        desarrollo que tu operación necesita hoy, con la capacidad de escalar mañana.
      </p>
    </header>

    <!-- ── Pestañas ────────────────────────────────────────────── -->
    <div class="pricing-tabs" role="tablist" aria-label="Categorías de paquetes">

      <button
        role="tab"
        id="ptab-ti"
        class="pricing-tab-btn is-active"
        aria-selected="true"
        aria-controls="ppanel-ti"
      >
        <span class="tab-name">Estabilidad Operativa</span>
        <span class="tab-sub">Planes de Soporte TI</span>
      </button>

      <button
        role="tab"
        id="ptab-web"
        class="pricing-tab-btn"
        aria-selected="false"
        aria-controls="ppanel-web"
      >
        <span class="tab-name">Presencia Digital</span>
        <span class="tab-sub">Paquetes Web</span>
      </button>

      <button
        role="tab"
        id="ptab-corp"
        class="pricing-tab-btn"
        aria-selected="false"
        aria-controls="ppanel-corp"
      >
        <span class="tab-name">Ingeniería Avanzada</span>
        <span class="tab-sub">Soluciones Corporativas</span>
      </button>

    </div>

    <!-- ════════════════════════════════════════════════════════════
         PANEL 1 — SOPORTE TI
    ════════════════════════════════════════════════════════════ -->
    <div
      id="ppanel-ti"
      role="tabpanel"
      aria-labelledby="ptab-ti"
      class="pricing-panel is-active"
    >

      <p class="panel-intro">
        <em>Nuestros esquemas de departamento de TI externo aseguran que nunca te detengas.</em>
      </p>

      <!-- ── Tarjetas de planes ─────────────────────────────── -->
      <div class="plans-grid" role="list">

        <!-- Essential -->
        <article class="plan-card" role="listitem">
          <div class="plan-card-inner">
            <div class="plan-header">
              <span class="plan-badge">Essential</span>
              <p class="plan-tagline">Agilidad para el día a día</p>
              <div class="plan-price">
                <span class="plan-amount">$550</span>
                <span class="plan-unit">MXN + IVA / equipo·mes</span>
              </div>
            </div>
            <p class="plan-desc">
              Ideal para startups o profesionales independientes que requieren
              asistencia rápida y confiable.
            </p>
            <ul class="plan-features">
              <li class="feat-yes">Soporte Remoto Ilimitado (5×8)</li>
              <li class="feat-yes">Monitoreo básico de antivirus</li>
              <li class="feat-yes">Soporte básico a conectividad internet</li>
              <li class="feat-no">Soporte ASPEL ni POS</li>
            </ul>
            <a href="#contacto" class="plan-cta plan-cta--ghost">Comenzar</a>
          </div>
        </article>

        <!-- Business Pro -->
        <article class="plan-card plan-card--featured" role="listitem">
          <div class="plan-card-inner">
            <div class="plan-featured-badge" aria-label="Plan recomendado">Recomendado</div>
            <div class="plan-header">
              <span class="plan-badge">Business Pro</span>
              <p class="plan-tagline">Continuidad Total</p>
              <div class="plan-price">
                <span class="plan-amount">$850</span>
                <span class="plan-unit">MXN + IVA / equipo·mes</span>
              </div>
            </div>
            <p class="plan-desc">
              El equilibrio perfecto: seguridad robusta y presencia física
              cuando se necesita.
            </p>
            <ul class="plan-features">
              <li class="feat-yes">Todo lo incluido en Essential</li>
              <li class="feat-yes">2 visitas en sitio mensuales</li>
              <li class="feat-yes">Soporte Técnico ASPEL (instalación y red)</li>
              <li class="feat-yes">Optimización avanzada Redes Wi-Fi / LAN</li>
              <li class="feat-yes">Mantenimiento físico trimestral</li>
              <li class="feat-yes">Gestión de impresoras y periféricos</li>
            </ul>
            <a href="#contacto" class="plan-cta plan-cta--primary">Comenzar</a>
          </div>
        </article>

        <!-- Premium -->
        <article class="plan-card" role="listitem">
          <div class="plan-card-inner">
            <div class="plan-header">
              <span class="plan-badge">Premium</span>
              <p class="plan-tagline">Infraestructura Global</p>
              <div class="plan-price">
                <span class="plan-amount">$1,350</span>
                <span class="plan-unit">MXN + IVA / equipo·mes</span>
              </div>
            </div>
            <p class="plan-desc">
              Para empresas críticas que simplemente no pueden permitirse
              detenerse.
            </p>
            <ul class="plan-features">
              <li class="feat-yes">Todo lo incluido en Business Pro</li>
              <li class="feat-yes">Soporte Prioritario para emergencias</li>
              <li class="feat-yes">4 visitas en sitio mensuales</li>
              <li class="feat-yes">Gestión de Servidores y VPNs</li>
              <li class="feat-yes">Backups en la Nube</li>
              <li class="feat-yes">Préstamo de equipo de respaldo</li>
            </ul>
            <a href="#contacto" class="plan-cta plan-cta--ghost">Comenzar</a>
          </div>
        </article>

      </div><!-- /plans-grid -->

      <!-- ── Tabla Comparativa ──────────────────────────────── -->
      <div class="compare-wrapper">
        <h3 class="compare-title">Comparativa de planes</h3>
        <div class="compare-scroll" role="region" aria-label="Tabla comparativa de planes" tabindex="0">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col" class="compare-feature-col">Característica</th>
                <th scope="col">Essential</th>
                <th scope="col" class="col-featured">Business Pro</th>
                <th scope="col">Premium</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Soporte Básico (Windows / Office / Correo)</td>
                <td><span class="ci ci--yes" aria-label="Incluido"></span></td>
                <td class="col-featured"><span class="ci ci--yes" aria-label="Incluido"></span></td>
                <td><span class="ci ci--yes" aria-label="Incluido"></span></td>
              </tr>
              <tr>
                <td>Soporte Técnico ASPEL y POS</td>
                <td><span class="ci ci--no" aria-label="No incluido"></span></td>
                <td class="col-featured"><span class="ci ci--yes" aria-label="Incluido"></span></td>
                <td><span class="ci ci--yes" aria-label="Incluido"></span></td>
              </tr>
              <tr>
                <td>Ciberseguridad &amp; Antivirus</td>
                <td><span class="ci-text">Básico</span></td>
                <td class="col-featured"><span class="ci-text">Avanzado</span></td>
                <td><span class="ci-text">Total</span></td>
              </tr>
              <tr>
                <td>Gestión de Red Wi-Fi / LAN</td>
                <td><span class="ci-text">Básica</span></td>
                <td class="col-featured"><span class="ci-text">Optimizada</span></td>
                <td><span class="ci-text">Avanzada</span></td>
              </tr>
              <tr>
                <td>Visitas en Sitio (Mensuales)</td>
                <td><span class="ci-text ci-text--muted">Costo Preferencial</span></td>
                <td class="col-featured"><span class="ci-text">2 incluidas</span></td>
                <td><span class="ci-text">4 incluidas</span></td>
              </tr>
              <tr>
                <td>Mantenimiento Físico</td>
                <td><span class="ci-text ci-text--muted">Costo Preferencial</span></td>
                <td class="col-featured"><span class="ci-text">Trimestral</span></td>
                <td><span class="ci-text">Bimestral</span></td>
              </tr>
              <tr>
                <td>Soporte 24/7 y Backups Cloud</td>
                <td><span class="ci ci--no" aria-label="No incluido"></span></td>
                <td class="col-featured"><span class="ci ci--no" aria-label="No incluido"></span></td>
                <td><span class="ci ci--yes" aria-label="Incluido"></span></td>
              </tr>
              <tr class="compare-price-row">
                <td>Inversión Mensual por Equipo</td>
                <td><strong>$550</strong></td>
                <td class="col-featured"><strong>$850</strong></td>
                <td><strong>$1,350</strong></td>
              </tr>
            </tbody>
          </table>
        </div><!-- /compare-scroll -->

        <!-- Condiciones -->
        <p class="compare-legal">
          El software y hardware son propiedad exclusiva del cliente, quien es responsable
          de cubrir los costos asociados de licencias o refacciones. Los costos presentados
          no incluyen IVA.
        </p>
      </div><!-- /compare-wrapper -->

      <!-- ── Beneficios por pago anticipado ─────────────────── -->
      <div class="discounts-block">
        <div class="discounts-header">
          <h3>Beneficios por Pago Anticipado</h3>
          <span class="discounts-tag">Política 2026</span>
        </div>
        <p class="discounts-desc">
          Optimiza tu presupuesto administrativo protegiendo tu infraestructura por adelantado:
        </p>
        <div class="discounts-grid" role="list">
          <div class="discount-item" role="listitem">
            <span class="discount-pct">3%</span>
            <span class="discount-label">Pago Trimestral</span>
          </div>
          <div class="discount-item" role="listitem">
            <span class="discount-pct">5%</span>
            <span class="discount-label">Pago Semestral</span>
          </div>
          <div class="discount-item discount-item--highlight" role="listitem">
            <span class="discount-pct">10%</span>
            <span class="discount-label">Pago Anual</span>
          </div>
        </div>
      </div>

    </div><!-- /ppanel-ti -->

    <!-- ════════════════════════════════════════════════════════════
         PANEL 2 — PAQUETES WEB
    ════════════════════════════════════════════════════════════ -->
    <div
      id="ppanel-web"
      role="tabpanel"
      aria-labelledby="ptab-web"
      class="pricing-panel"
    >

      <p class="panel-intro">
        <em>Construimos tu presencia digital con la misma solidez que nuestras redes.</em>
      </p>

      <!-- Beneficios base -->
      <div class="web-base-benefits">
        <p class="web-base-label">Todos los paquetes incluyen:</p>
        <ul class="web-base-list">
          <li>
            <span class="wb-icon" aria-hidden="true">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9" />
              </svg>
            </span>
            Hospedaje (Espacio en línea)
          </li>

          <li>
            <span class="wb-icon" aria-hidden="true">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </span>
            Asesoría y consulta gratuitas
          </li>
          <li>
            <span class="wb-icon" aria-hidden="true">
              <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </span>
            1 año completo de soporte técnico
          </li>
        </ul>
      </div>

      <!-- Tarjetas de paquetes web -->
      <div class="plans-grid" role="list">

        <!-- One Page -->
        <article class="plan-card" role="listitem">
          <div class="plan-card-inner">
            <div class="plan-header">
              <span class="plan-badge">One Page</span>
              <p class="plan-tagline">Impacto concentrado</p>
              <div class="plan-price">
                <span class="plan-amount">$5,000</span>
                <span class="plan-unit">MXN · pago único</span>
              </div>
            </div>
            <p class="plan-desc">
              Una página web de impacto condensada en navegación fluida. Ideal
              para lanzar un producto, evento o portafolio rápido.
            </p>
            <ul class="plan-features">
              <li class="feat-yes">Diseño responsive y moderno</li>
              <li class="feat-yes">Sección única de navegación fluida</li>
              <li class="feat-yes">Formulario de contacto integrado</li>
              <li class="feat-yes">Optimización SEO base</li>
            </ul>
            <a href="#contacto" class="plan-cta plan-cta--ghost">Cotizar</a>
          </div>
        </article>

        <!-- Corporativa -->
        <article class="plan-card plan-card--featured" role="listitem">
          <div class="plan-card-inner">
            <div class="plan-featured-badge" aria-label="Más popular">Más popular</div>
            <div class="plan-header">
              <span class="plan-badge">Corporativa</span>
              <p class="plan-tagline">Presencia completa</p>
              <div class="plan-price">
                <span class="plan-amount">$7,000</span>
                <span class="plan-unit">MXN · pago único</span>
              </div>
            </div>
            <p class="plan-desc">
              Sitio web estructurado con múltiples secciones diseñado para
              presentar la amplitud de tu negocio y mejorar tu posicionamiento.
            </p>
            <ul class="plan-features">
              <li class="feat-yes">Inicio, Servicios, Nosotros, Contacto</li>
              <li class="feat-yes">Blog o sección de noticias</li>
              <li class="feat-yes">SEO avanzado y velocidad optimizada</li>
              <li class="feat-yes">Integración con Google Analytics</li>
              <li class="feat-yes">Panel de administración CMS</li>
            </ul>
            <a href="#contacto" class="plan-cta plan-cta--primary">Cotizar</a>
          </div>
        </article>

        <!-- E-Commerce -->
        <article class="plan-card" role="listitem">
          <div class="plan-card-inner">
            <div class="plan-header">
              <span class="plan-badge">E-Commerce</span>
              <p class="plan-tagline">Tu tienda 24/7</p>
              <div class="plan-price">
                <span class="plan-amount">$9,000</span>
                <span class="plan-unit">MXN · pago único</span>
              </div>
            </div>
            <p class="plan-desc">
              Tu sucursal digital siempre abierta. Catálogo, pasarela de pagos
              y gestión de inventario para escalar tus ventas.
            </p>
            <ul class="plan-features">
              <li class="feat-yes">Catálogo de productos ilimitado</li>
              <li class="feat-yes">Pasarela de pagos (Stripe / MercadoPago)</li>
              <li class="feat-yes">Gestión de inventario y pedidos</li>
              <li class="feat-yes">Panel de administración CMS</li>
              <li class="feat-yes">SEO para e-commerce</li>
            </ul>
            <a href="#contacto" class="plan-cta plan-cta--ghost">Cotizar</a>
          </div>
        </article>

      </div><!-- /plans-grid web -->

      <!-- Consideraciones técnicas -->
      <div class="web-notes">
        <div class="web-notes-header">
          <span class="web-notes-icon" aria-hidden="true">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          <h4 class="web-notes-title">Consideraciones Técnicas y Transparencia</h4>
        </div>
        <p class="web-notes-intro">Para garantizar un despliegue exitoso y fluido de tu proyecto web, establecemos las siguientes bases operativas:</p>
        <ul class="web-notes-list">
          <li>
            <strong>Dominio web:</strong> Es un costo adicional sujeto a disponibilidad. Te ayudaremos a encontrar el mejor nombre al precio ideal.
          </li>
          <li>
            <strong>Gestión y accesos:</strong> Puedes administrar tu dominio o delegarlo a nosotros. Si lo administras tú, solo requeriremos acceso temporal a la configuración para conectar el sitio.
          </li>
          <li>
            <strong>Materiales y ajustes:</strong> Tu paquete incluye 2 rondas de revisión. Para agilizar el desarrollo, necesitaremos tus textos y logotipo antes de arrancar.
          </li>
          <li>
            <strong>Seguridad y renovaciones:</strong> Entregamos tu sitio protegido con certificado de seguridad (HTTPS). A partir del segundo año, aplicará un costo de renovación transparente por hosting, soporte y dominio.
          </li>
        </ul>
      </div>

    </div><!-- /ppanel-web -->

    <!-- ════════════════════════════════════════════════════════════
         PANEL 3 — INGENIERÍA AVANZADA
    ════════════════════════════════════════════════════════════ -->
    <div
      id="ppanel-corp"
      role="tabpanel"
      aria-labelledby="ptab-corp"
      class="pricing-panel"
    >

      <!-- Encabezado ejecutivo -->
      <div class="corp-hero">
        <div class="corp-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M8.504 9.426l3 -1.714a1 1 0 0 1 .992 0l3 1.714a1 1 0 0 1 .504 .868v3.411a1 1 0 0 1 -.504 .868l-3 1.715a1 1 0 0 1 -.992 0l-3 -1.715a1 1 0 0 1 -.504 -.868v-3.41a1 1 0 0 1 .504 -.869" />
            <path d="M15.75 9.964l-3.75 2.036" />
            <path d="M12 12l-3.75 -2.036" />
            <path d="M12 12v4.071" />
            <path d="M3 7v-2a2 2 0 0 1 2 -2h2" />
            <path d="M3 17v2a2 2 0 0 0 2 2h2" />
            <path d="M17 3h2a2 2 0 0 1 2 2v2" />
            <path d="M17 21h2a2 2 0 0 0 2 -2v-2" />
          </svg>
        </div>
        <h3 class="corp-title">Soluciones Corporativas y Proyectos a la Medida</h3>
        <p class="corp-intro">
          No ofrecemos "soluciones de caja". Desarrollamos la arquitectura tecnológica
          y los modelos de automatización que tu empresa necesita para escalar.
        </p>
      </div>

      <!-- Bloques de capacidades -->
      <div class="corp-blocks">

        <!-- Bloque Arquitectura -->
        <div class="corp-block">
          <div class="corp-block-label">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            Arquitectura y Software
          </div>
          <h4 class="corp-block-title">Desarrollo a la Medida</h4>
          <p class="corp-block-desc">
            Construimos el motor de tu operación. Desde plataformas robustas
            (ERPs, Gestores Documentales) hasta APIs seguras para interconectar
            tus sistemas actuales y bases de datos preparadas para alto volumen.
          </p>
        </div>

        <!-- Bloque IA -->
        <div class="corp-block">
          <div class="corp-block-label">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            Automatización e IA
          </div>
          <h4 class="corp-block-title">Eficiencia Inteligente</h4>
          <p class="corp-block-desc">
            Reduce el error humano y acelera procesos mediante scripts a la medida.
            Implementamos IA Generativa y Búsqueda Inteligente (RAG) adaptada a los
            datos de tu organización para consultas conversacionales inmediatas.
          </p>
        </div>

      </div><!-- /corp-blocks -->

      <!-- Proceso de ingeniería -->
      <div class="corp-process">
        <div class="corp-process-header">
          <p class="corp-process-label">Inversión: Cotización por Proyecto</p>
          <p class="corp-process-desc">
            Dado el nivel de especialización, estructuramos tu desarrollo en tres fases claras:
          </p>
        </div>
        <ol class="corp-phases">
          <li class="corp-phase">
            <span class="corp-phase-num">01</span>
            <div>
              <strong class="corp-phase-title">Discovery — Consultoría inicial</strong>
              <p>Analizamos tus cuellos de botella y definimos el objetivo comercial del sistema.</p>
            </div>
          </li>
          <li class="corp-phase">
            <span class="corp-phase-num">02</span>
            <div>
              <strong class="corp-phase-title">Arquitectura</strong>
              <p>Diseñamos el mapa tecnológico, las herramientas y las fases.</p>
            </div>
          </li>
          <li class="corp-phase">
            <span class="corp-phase-num">03</span>
            <div>
              <strong class="corp-phase-title">Desarrollo</strong>
              <p>Ejecución con cronograma transparente antes de la primera línea de código.</p>
            </div>
          </li>
        </ol>

        <!-- CTA principal -->
        <div class="corp-cta-wrapper">
          <a href="#contacto" class="nav-cta">
            Agendar Consultoría Técnica
          </a>
          <p class="corp-cta-note">Sin costo · Sin compromiso · Primera sesión estratégica gratuita</p>
        </div>

      </div><!-- /corp-process -->

    </div><!-- /ppanel-corp -->

  </div><!-- /container -->
</section>

<script>
  // ── Cambio de pestañas con animación fadeInUp ───────────────────
  const ptabs   = document.querySelectorAll<HTMLButtonElement>('.pricing-tab-btn');
  const ppanels = document.querySelectorAll<HTMLElement>('.pricing-panel');

  ptabs.forEach(tab => {
    tab.addEventListener('click', () => {
      ptabs.forEach(t => { t.setAttribute('aria-selected', 'false'); t.classList.remove('is-active'); });
      ppanels.forEach(p => {
        p.classList.remove('is-active');
        // Remueve la animación para que se pueda relanzar
        p.style.animation = 'none';
      });
      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('is-active');
      const target = document.getElementById(tab.getAttribute('aria-controls')!);
      if (target) {
        target.classList.add('is-active');
        // Forzar reflow para que la animación se relance
        void target.offsetWidth;
        target.style.animation = '';
      }
    });
  });
</script>

