---
/**
 * components/ServiceCard.astro
 * Tarjeta de servicio minimalista.
 * Muestra: icono + título + descripción (una línea).
 * Detalle (features + cross-sell): visible en hover desktop / toggle en móvil.
 */

interface CrossSell {
  text: string;
  href: string;
  targetTab?: string;
}

interface Props {
  icon: string;
  title: string;
  description: string;
  features: string[];
  crossSell?: CrossSell;
}

const { icon, title, description, features, crossSell } = Astro.props;
---

<article class="service-card" role="listitem">

  <!-- Vista frontal: siempre visible -->
  <div class="service-card-front">
    <div class="service-icon" aria-hidden="true" set:html={icon} />
    <h3>{title}</h3>
    <p class="service-desc">{description}</p>
  </div>

  <!-- Divisor sutil: invisible en estado base, visible al expandir -->
  <hr class="service-divider" aria-hidden="true" />

  <!-- Detalle: visible en hover (desktop) o al expandir (móvil) -->
  <div class="service-card-details" aria-hidden="true">
    <ul class="service-features">
      {features.map((f) => <li>{f}</li>)}
    </ul>

    {crossSell && (
      <a
        href={crossSell.href}
        class="service-cross-sell"
        data-target-tab={crossSell.targetTab}
      >
        <svg class="service-cross-sell-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>{crossSell.text}</span>
      </a>
    )}
  </div>

  <!-- Botón expand (visible solo en táctil / sin hover) -->
  <button
    type="button"
    class="service-expand-btn"
    aria-expanded="false"
    aria-label={`Ver detalles: ${title}`}
  >
    <span class="expand-label">Saber más</span>
    <svg class="expand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

</article>
