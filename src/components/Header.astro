---
/**
 * components/Header.astro
 * Barra de navegación principal.
 * Semántica: <header> + <nav> con aria-label.
 */

const navLinks = [
  { label: 'Nosotros',  href: '#nosotros'  },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Contacto',  href: '#contacto'  },
];
---

<header class="site-header" role="banner">
  <div class="container">

    <!-- Logo: enlace a inicio, texto alternativo para screen readers -->
    <a href="/" aria-label="Alexandria Studio — Ir al inicio" class="logo">
      <!--
        Usar <img> con SVG del logotipo o texto con icono.
        El texto "Alexandria Studio" actúa como fallback accesible.
      -->
      <img
        src="/images/logo.svg"
        alt="Alexandria Studio"
        width="180"
        height="40"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <!--
      <nav> con aria-label para diferenciarla si hubiera más navs en la página.
      Los href apuntan a anclas de las secciones (SPA-style scroll).
    -->
    <nav aria-label="Navegación principal">
      <ul role="list">
        {navLinks.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>

      <!-- CTA secundario en la nav -->
      <a href="#contacto" class="nav-cta">
        Habla con nosotros
      </a>
    </nav>

    <!-- Botón hamburguesa para móvil (JS de toggle se añade aparte) -->
    <button
      type="button"
      class="mobile-menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- Icono hamburguesa (SVG inline o heroicons) -->
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

  </div>
</header>
