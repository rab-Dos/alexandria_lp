---
/**
 * components/Header.astro
 * Barra de navegación principal — diseño "squircle flotante".
 * Semántica: <header> + <nav> con aria-label.
 */

const navLinks = [
  { label: 'Nuestra Esencia',  href: '#nosotros'  },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Paquetes',  href: '#paquetes'  },
  { label: 'Contacto',  href: '#contacto'  },
];
---

<header class="site-header" role="banner">

  <!-- ── Barra principal ──────────────────────────────────── -->
  <div class="nav-pill">

    <a href="#inicio" aria-label="Alexandria Studio — Ir al inicio" class="logo">
      <img
        src="/Alexandria_alternativo.svg"
        alt=""
        width="26"
        height="26"
        loading="eager"
        fetchpriority="high"
        aria-hidden="true"
      />
      <span>Alexandria Studio</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul role="list">
        {navLinks.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a href="#contacto" class="nav-cta">Habla con nosotros</a>
    </div>

    <button
      type="button"
      id="mobile-menu-btn"
      class="mobile-menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

  </div>

  <!-- ── Menú desplegable móvil ────────────────────────────── -->
  <div
    id="mobile-menu"
    class="mobile-menu"
    aria-hidden="true"
  >
    <nav aria-label="Navegación móvil">
      <ul>
        {navLinks.map(({ label, href }) => (
          <li>
            <a href={href} class="mobile-menu-link">{label}</a>
          </li>
        ))}
      </ul>
      <a href="#contacto" class="btn btn-primary mobile-menu-cta">
        Habla con nosotros
      </a>
    </nav>
  </div>

</header>

<script>
  const btn  = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu')     as HTMLElement | null;

  function closeMenu() {
    if (!menu || !menu.classList.contains('is-open')) return;
    menu.classList.add('is-closing');
    menu.classList.remove('is-open');
    btn?.setAttribute('aria-expanded', 'false');
    btn?.setAttribute('aria-label', 'Abrir menú de navegación');
    menu.setAttribute('aria-hidden', 'true');
    btn?.classList.remove('is-active');
    // Quitar is-closing una vez termina la animación de salida
    menu.addEventListener('animationend', () => {
      menu!.classList.remove('is-closing');
    }, { once: true });
  }

  btn?.addEventListener('click', () => {
    if (menu!.classList.contains('is-open') || menu!.classList.contains('is-closing')) {
      closeMenu();
    } else {
      menu!.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Cerrar menú de navegación');
      menu!.setAttribute('aria-hidden', 'false');
      btn.classList.add('is-active');
    }
  });

  // Cerrar el menú con fadeout al hacer clic en un enlace
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => closeMenu());
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu?.classList.contains('is-open')) return;
    closeMenu();
    btn?.focus();
  });
</script>
