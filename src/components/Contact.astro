---
/**
 * components/Contact.astro
 * Sección de contacto — tarjetas con especialistas y canales directos.
 *
 * Estructura minimalista sin intermediarios. Los usuarios pueden contactar
 * directamente por email, teléfono, WhatsApp o LinkedIn.
 *
 * Accesibilidad:
 *  - Enlaces diretos con tel:, mailto:, https://wa.me/, https://linkedin.com/
 *  - Íconos con aria-hidden (decorativos) o aria-label cuando lo requieran.
 */

import Mail from './icons/mail.svg?raw';
import Phone from './icons/phone.svg?raw';
import WhatsApp from './icons/whatsapp.svg?raw';
import Linkedin from './icons/linkedin.svg?raw';
---

<section
  id="contacto"
  aria-labelledby="contact-heading"
  class="contact-section"
>
  <div class="container">

    <!-- H2 — Título de sección -->
    <h2 id="contact-heading">
      ¿Listo para tu evolución tecnológica? Hablemos.
    </h2>

    <p class="section-subtitle">
      Sin formularios automatizados ni intermediarios. Contacta directamente a nuestros especialistas para agendar tu consultoría o resolver cualquier emergencia operativa.
    </p>

    <!-- Grid de tarjetas de contacto (2 especialistas) -->
    <div class="contact-cards-grid">

      <!-- Tarjeta 1: Porfirio A Rivera C -->
      <div class="contact-card">
        <div class="contact-card-header">
          <h3 class="contact-card-name">Porfirio A Rivera C</h3>
          <p class="contact-card-role">Liderazgo Técnico e Infraestructura y Sistemas</p>
        </div>

        <ul class="contact-links">
          <li>
            <a href="mailto:andres.rivera@alexandriastudio.cloud" class="contact-link">
              <span class="contact-icon" aria-hidden="true" set:html={Mail} />
              <span class="contact-text">andres.rivera@alexandriastudio.cloud</span>
            </a>
          </li>
          <li>
            <a href="tel:+525518505071" class="contact-link">
              <span class="contact-icon" aria-hidden="true" set:html={Phone} />
              <span class="contact-text">+52 55 1850 5071</span>
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/525518505071"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              aria-label="Chatear por WhatsApp"
            >
              <span class="contact-icon" aria-hidden="true" set:html={WhatsApp} />
              <span class="contact-text">Chatear por WhatsApp</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/porfirio-andres-rivera-cigala-485557b2/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              aria-label="Conectar en LinkedIn"
            >
              <span class="contact-icon" aria-hidden="true" set:html={Linkedin} />
              <span class="contact-text">Conectar en LinkedIn</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Tarjeta 2: Jesús Arellano Flores -->
      <div class="contact-card">
        <div class="contact-card-header">
          <h3 class="contact-card-name">Jesús Arellano Flores</h3>
          <p class="contact-card-role">Consultoría y Arquitectura de Desarrollo e IA</p>
        </div>

        <ul class="contact-links">
          <li>
            <a href="mailto:jesus.arellano@alexandriastudio.cloud" class="contact-link">
              <span class="contact-icon" aria-hidden="true" set:html={Mail} />
              <span class="contact-text">jesus.arellano@alexandriastudio.cloud</span>
            </a>
          </li>
          <li>
            <a href="tel:+525615912984" class="contact-link">
              <span class="contact-icon" aria-hidden="true" set:html={Phone} />
              <span class="contact-text">+52 56 1591 2984</span>
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/525615912984"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              aria-label="Chatear por WhatsApp"
            >
              <span class="contact-icon" aria-hidden="true" set:html={WhatsApp} />
              <span class="contact-text">Chatear por WhatsApp</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/arellano-jesus/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-link"
              aria-label="Conectar en LinkedIn"
            >
              <span class="contact-icon" aria-hidden="true" set:html={Linkedin} />
              <span class="contact-text">Conectar en LinkedIn</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

  </div>
</section>
