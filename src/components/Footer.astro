---
/**
 * components/Footer.astro
 * Pie de página global — copyright, enlaces legales y créditos.
 */

const currentYear = new Date().getFullYear();

const legalLinks = [
  { label: 'Aviso de Privacidad', href: '/privacidad' },
  { label: 'Términos de Uso',     href: '/terminos'   },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-layout">
      <div class="footer-brand">
        <a href="/" aria-label="Alexandria Studio — Inicio">
          <img
            src="/Alexandria_alternativo.svg"
            alt="Alexandria Studio"
            width="140"
            height="32"
            loading="lazy"
          />
        </a>
        <p class="footer-tagline">
          Guiamos la evolución tecnológica de tu negocio.
        </p>
      </div>

      <nav aria-label="Mapa del sitio">
        <h3 class="footer-nav-title">Navegación</h3>
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#nosotros">Nuestra Esencia</a></li>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#paquetes">Paquetes</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </nav>

      <div class="footer-services">
        <h3 class="footer-nav-title">Servicios</h3>
        <div class="footer-services-grid">
          <div>
            <p class="footer-pillar-label">Estabilidad Operativa</p>
            <ul>
              <li>Mesa de Ayuda</li>
              <li>Mantenimiento Preventivo</li>
              <li>Infraestructura de Redes</li>
              <li>Ciberseguridad y Protección</li>
              <li>Sistemas Administrativos y POS</li>
            </ul>
          </div>
          <div>
            <p class="footer-pillar-label">Ingeniería y Evolución</p>
            <ul>
              <li>Desarrollo Web y Plataformas</li>
              <li>Software y Arquitectura a la Medida</li>
              <li>Automatización e Inteligencia Artificial</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-globe" aria-hidden="true">
    <div id="footer-globe-canvas"></div>
  </div>

  <div class="container">
    <div class="footer-bottom">
      <small>
        &copy; {currentYear} Alexandria Studio. Todos los derechos reservados.
      </small>

      <nav aria-label="Enlaces legales">
        <ul class="legal-links">
          {legalLinks.map(({ label, href }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<script>
  const globeContainer = document.getElementById('footer-globe-canvas');

  if (globeContainer && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let requested = false;
    const loadGlobe = async (): Promise<void> => {
      if (requested) return;
      requested = true;
      const { initFooterGlobe } = await import('../scripts/footer-globe');
      await initFooterGlobe(globeContainer);
    };

    if ('IntersectionObserver' in window) {
      const loadObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        void loadGlobe();
      }, { rootMargin: '400px 0px', threshold: 0 });
      loadObserver.observe(globeContainer);
    } else {
      void loadGlobe();
    }
  }
</script>
