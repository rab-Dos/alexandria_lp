---
/**
 * components/Services.astro
 * Sección de servicios — dos pilares navegables con pestañas.
 * Pilar 1: Estabilidad Operativa · Pilar 2: Ingeniería y Evolución
 */

import ServiceCard from './ServiceCard.astro';

import LifeBuoy    from './icons/lifebuoy.svg?raw';
import Activity    from './icons/activity.svg?raw';
import Network     from './icons/network.svg?raw';
import ShieldCheck from './icons/shield-check.svg?raw';
import Calculator  from './icons/calculator.svg?raw';
import Monitor     from './icons/monitor.svg?raw';
import Braces      from './icons/braces.svg?raw';
import Brain       from './icons/brain.svg?raw';

const stability = [
  {
    icon: LifeBuoy,
    title: 'Mesa de Ayuda',
    description: 'Soporte integral para que tu equipo trabaje sin interrupciones técnicas.',
    features: [
      'Mantenimiento preventivo y correctivo de equipos',
      'Soporte Windows y macOS (pantallas azules, lentitud, actualizaciones)',
      'Microsoft Office, Outlook y lectores PDF',
      'Gestión de cuentas, Directorio Activo y correos corporativos',
      'Impresoras, escáneres y periféricos',
    ],
    crossSell: {
      text: '¿Cansado de tareas repetitivas? Automatiza tus procesos diarios.',
      href: '#servicios',
      targetTab: 'panel-engineering',
    },
  },
  {
    icon: Activity,
    title: 'Mantenimiento Preventivo',
    description: 'Prolonga la vida útil de tus activos con revisiones y actualizaciones programadas.',
    features: [
      'Limpieza física de hardware (CPU, laptops, servidores)',
      'Actualizaciones programadas fuera de horario operativo',
      'Diagnóstico de rendimiento y recomendaciones de upgrades',
    ],
  },
  {
    icon: Network,
    title: 'Infraestructura de Redes',
    description: 'Redes estables y seguras para toda tu oficina, sin zonas muertas.',
    features: [
      'Wi-Fi corporativo: eliminación de zonas muertas',
      'Configuración de redes de invitados y principales',
      'Cableado estructurado y switching para máxima velocidad',
    ],
  },
  {
    icon: ShieldCheck,
    title: 'Ciberseguridad y Protección',
    description: 'Blindamos tus equipos e información crítica ante ataques digitales.',
    features: [
      'Blindaje de equipos contra ataques y ransomware',
      'Limpieza lógica y optimización de rendimiento',
      'Políticas de respaldo (Backup) para información crítica',
    ],
  },
  {
    icon: Calculator,
    title: 'Sistemas Administrativos y POS',
    description: 'Soporte especializado para ASPEL, puntos de venta y periféricos.',
    features: [
      'ASPEL SAE, COI y NOI (instalación, red y respaldos)',
      'Impresoras térmicas y lectores de código de barras',
      'Cajones de dinero y periféricos POS',
    ],
    crossSell: {
      text: '¿Tu volumen de datos ya superó a tu sistema actual? Descubre nuestro desarrollo de Software a la Medida.',
      href: '#servicios',
      targetTab: 'panel-engineering',
    },
  },
];

const engineering = [
  {
    icon: Monitor,
    title: 'Desarrollo Web y Plataformas',
    description: 'Sitios y plataformas corporativas modernas que representan tu identidad digital.',
    features: [
      'Presencia Digital: diseño y despliegue de sitios web corporativos modernos, rápidos y responsivos',
      'Portales a la Medida: plataformas web interactivas adaptadas a la identidad y necesidades de tu empresa',
    ],
  },
  {
    icon: Braces,
    title: 'Software y Arquitectura a la Medida',
    description: 'APIs, bases de datos y sistemas ERP/DMS diseñados para tu operación específica.',
    features: [
      'Arquitectura Backend: APIs robustas y de alto rendimiento para interconectar tus sistemas comerciales',
      'Bases de Datos Avanzadas: diseño, optimización y mantenimiento de bases de datos relacionales complejas',
      'Sistemas Core Corporativos: plataformas DMS y módulos ERP adaptados a tus reglas de negocio',
    ],
  },
  {
    icon: Brain,
    title: 'Automatización e IA: Reduce el error humano y acelera tus procesos internos',
    description: 'Automatización inteligente e IA integrada para potenciar tu operación.',
    features: [
      'Eficiencia Operativa: automatización de flujos de trabajo y tareas repetitivas mediante scripts',
      'Integración de IA Generativa: modelos de inteligencia artificial en tus sistemas para análisis y creación de contenido',
      'Búsqueda Inteligente (RAG): recuperación de información empresarial con bases de datos vectoriales para consultas conversacionales',
    ],
  },
];
---

<section
  id="servicios"
  aria-labelledby="services-heading"
  class="services-section"
>
  <div class="container">

    <h2 id="services-heading">
      Servicios diseñados para impulsar tu negocio
    </h2>

    <p class="section-subtitle">
      Dos pilares complementarios: primero estabilizamos tu operación,
      luego la llevamos al siguiente nivel.
    </p>

    <!-- Pestañas de pilares -->
    <div class="services-tabs" role="tablist" aria-label="Pilares de servicio">

      <button
        type="button"
        role="tab"
        id="tab-stability"
        class="services-tab-btn is-active"
        aria-selected="true"
        aria-controls="panel-stability"
        tabindex="0"
      >
        <span class="tab-eyebrow">Pilar 1</span>
        <span class="tab-name">Estabilidad Operativa</span>
        <span class="tab-sub">El Cimiento</span>
      </button>

      <button
        type="button"
        role="tab"
        id="tab-engineering"
        class="services-tab-btn"
        aria-selected="false"
        aria-controls="panel-engineering"
        tabindex="-1"
      >
        <span class="tab-eyebrow">Pilar 2</span>
        <span class="tab-name">Ingeniería y Evolución</span>
        <span class="tab-sub">El Crecimiento</span>
      </button>

    </div>

    <!-- Panel Pilar 1 -->
    <div
      id="panel-stability"
      role="tabpanel"
      aria-labelledby="tab-stability"
      class="services-panel is-active"
      tabindex="0"
    >
      <div class="services-grid" role="list">
        {stability.map((s) => (
          <ServiceCard
            icon={s.icon}
            title={s.title}
            description={s.description}
            features={s.features}
            crossSell={s.crossSell}
          />
        ))}
      </div>
    </div>

    <!-- Panel Pilar 2 -->
    <div
      id="panel-engineering"
      role="tabpanel"
      aria-labelledby="tab-engineering"
      class="services-panel"
      tabindex="0"
      hidden
    >
      <div class="services-grid services-grid--centered" role="list">
        {engineering.map((s) => (
          <ServiceCard
            icon={s.icon}
            title={s.title}
            description={s.description}
            features={s.features}
          />
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  // ── Cambio de pestañas ──
  const tabs   = document.querySelectorAll<HTMLButtonElement>('.services-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.services-panel');

  function collapseAllCards(): void {
    document.querySelectorAll<HTMLElement>('.service-card.is-expanded').forEach(collapseCard);
  }

  function activateTab(tab: HTMLButtonElement): void {
    // Cerrar todas las tarjetas abiertas antes de cambiar de panel
    collapseAllCards();
    tabs.forEach(t => {
      t.setAttribute('aria-selected', 'false');
      t.setAttribute('tabindex', '-1');
      t.classList.remove('is-active');
    });
    panels.forEach(p => {
      p.classList.remove('is-active');
      p.hidden = true;
    });
    tab.setAttribute('aria-selected', 'true');
    tab.setAttribute('tabindex', '0');
    tab.classList.add('is-active');
    const target = document.getElementById(tab.getAttribute('aria-controls')!);
    if (target) {
      target.hidden = false;
      target.classList.add('is-active');
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', (event) => {
      let nextIndex: number | undefined;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = tabs.length - 1;
      if (nextIndex === undefined) return;
      event.preventDefault();
      const nextTab = tabs[nextIndex];
      activateTab(nextTab);
      nextTab.focus();
    });
  });

  // ── Expand/collapse de tarjetas — mutuamente excluyentes (táctil / móvil) ──
  function collapseCard(card: HTMLElement): void {
    card.classList.remove('is-expanded');
    const btn = card.querySelector<HTMLButtonElement>('.service-expand-btn');
    const details = card.querySelector<HTMLElement>('.service-card-details');
    if (!btn) return;
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', `Ver detalles: ${btn.dataset.serviceTitle ?? 'servicio'}`);
    if (details) details.hidden = true;
    const label = btn.querySelector('.expand-label');
    if (label) label.textContent = 'Saber más';
  }

  document.querySelectorAll<HTMLButtonElement>('.service-expand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const card     = btn.closest<HTMLElement>('.service-card')!;
      const willExpand = !card.classList.contains('is-expanded');

      // Cerrar todas las tarjetas del mismo panel
      const panel = card.closest<HTMLElement>('.services-panel');
      panel?.querySelectorAll<HTMLElement>('.service-card').forEach(c => {
        if (c !== card) collapseCard(c);
      });

      if (willExpand) {
        const details = card.querySelector<HTMLElement>('.service-card-details');
        if (details) details.hidden = false;
        card.classList.add('is-expanded');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', `Ocultar detalles: ${btn.dataset.serviceTitle ?? 'servicio'}`);
        const label = btn.querySelector('.expand-label');
        if (label) label.textContent = 'Ver menos';
      } else {
        collapseCard(card);
      }
    });
  });

  // ── Cross-sell: los enlaces dentro de Pilar 1 activan Pilar 2 ──
  // activateTab ya cierra todas las tarjetas, incluida la que contiene el enlace cross-sell
  document.querySelectorAll<HTMLAnchorElement>('[data-target-tab]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.dataset.targetTab!;
      const tab = document.querySelector<HTMLButtonElement>(`[aria-controls="${targetId}"]`);
      if (tab) {
        activateTab(tab);
        tab.focus();
      }
      document.getElementById('servicios')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

